---
import Base from '../layouts/Base.astro';
---
<Base title="Mock Test">
  <main class="mx-auto max-w-5xl px-4 py-6">
    <div id="msg" class="hidden rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>
    <div id="loading" class="py-20 text-center text-slate-500">Loading test...</div>

    <!-- Locked -->
    <section id="locked" class="mx-auto hidden max-w-md rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm">
      <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-amber-100 text-2xl">🔒</div>
      <h1 class="mt-4 text-xl font-bold text-slate-900">Locked Content</h1>
      <p id="locked-title" class="mt-1 font-medium text-slate-700"></p>
      <p class="mt-2 text-sm text-slate-500">This is a Pro test. Get the 30 day pass to unlock every test.</p>
      <button id="locked-pay" type="button" data-open-pay class="mt-5 w-full rounded-xl bg-indigo-600 px-4 py-3 font-semibold text-white hover:bg-indigo-700"></button>
      <a id="back1" href="#" class="mt-3 block text-sm font-medium text-slate-500 underline">Back to dashboard</a>
    </section>

    <!-- Intro -->
    <section id="intro" class="mx-auto hidden max-w-xl rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
      <p id="i-cat" class="text-xs font-semibold uppercase tracking-wide text-indigo-600"></p>
      <h1 id="i-title" class="mt-1 text-2xl font-bold text-slate-900"></h1>
      <ul class="mt-4 space-y-1.5 text-sm text-slate-600"><li id="i-q"></li><li id="i-d"></li><li>1 mark for each correct answer, no negative marking</li><li>Your progress is saved if you refresh the page</li></ul>
      <div class="mt-6 flex flex-wrap gap-3">
        <button id="start" type="button" class="rounded-xl bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700"></button>
        <a id="back2" href="#" class="rounded-xl border border-slate-300 px-6 py-3 font-semibold text-slate-700 hover:bg-slate-50">Back</a>
      </div>
    </section>

    <!-- Exam -->
    <section id="exam" class="hidden">
      <div class="sticky top-14 z-30 flex items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
        <strong id="e-title" class="truncate text-sm text-slate-800 sm:text-base"></strong>
        <div class="flex items-center gap-3">
          <span id="timer" class="rounded-full bg-slate-100 px-3 py-1 font-semibold tabular-nums text-slate-800" role="timer">--:--</span>
          <button id="submit" type="button" class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Submit Test</button>
        </div>
      </div>
      <div class="mt-4 grid gap-4 md:grid-cols-[1fr_16rem]">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
          <p id="qn" class="text-sm font-semibold text-indigo-600"></p>
          <h2 id="qt" class="mt-2 text-lg font-semibold leading-relaxed text-slate-900"></h2>
          <div id="opts" class="mt-5 space-y-3" role="radiogroup"></div>
          <div class="mt-6 flex flex-wrap gap-2">
            <button id="prev" type="button" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40">Previous</button>
            <button id="mark" type="button" class="rounded-xl border border-violet-300 px-4 py-2.5 text-sm font-semibold text-violet-700 hover:bg-violet-50"></button>
            <button id="next" type="button" class="rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700"></button>
          </div>
        </div>
        <aside class="h-fit rounded-2xl border border-slate-200 bg-white p-4 md:sticky md:top-32">
          <h3 class="text-sm font-semibold text-slate-900">Question palette</h3>
          <div id="pal" class="mt-3 grid grid-cols-5 gap-2"></div>
          <ul class="mt-4 space-y-1.5 text-xs text-slate-500">
            <li><span class="mr-2 inline-block h-3 w-3 rounded bg-emerald-500 align-middle"></span>Answered</li>
            <li><span class="mr-2 inline-block h-3 w-3 rounded bg-violet-500 align-middle"></span>Marked for review</li>
            <li><span class="mr-2 inline-block h-3 w-3 rounded bg-slate-200 align-middle"></span>Not answered</li>
          </ul>
        </aside>
      </div>
    </section>

    <!-- Result -->
    <section id="result" class="hidden">
      <h1 class="text-2xl font-bold text-slate-900">Test result</h1>
      <p id="r-title" class="text-slate-500"></p>
      <div id="stats" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6"></div>
      <p id="saved" class="mt-3 text-sm text-slate-500"></p>
      <h2 class="mt-8 text-lg font-bold text-slate-900">Question review</h2>
      <div id="review" class="mt-3 space-y-3"></div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a id="back3" href="#" class="rounded-xl bg-indigo-600 px-5 py-2.5 font-semibold text-white hover:bg-indigo-700">Back to dashboard</a>
        <button id="retake" type="button" class="rounded-xl border border-slate-300 px-5 py-2.5 font-semibold text-slate-700 hover:bg-slate-50">Retake test</button>
      </div>
    </section>
  </main>
</Base>

<script>
  import { supabase, configured } from '../lib/supabase.js';
  import { requireUser, getProfile, isPro } from '../lib/auth.js';
  import { esc, fmtTime } from '../lib/ui.js';
  import { PLAN_PRICE } from '../lib/config.js';
  import { u } from '../lib/url.js';

  const $ = id => document.getElementById(id);
  const L = 'ABCD';
  const dash = u('/dashboard/');
  ['back1', 'back2', 'back3'].forEach(i => $(i).setAttribute('href', dash));
  const only = name => { for (const s of ['loading', 'locked', 'intro', 'exam', 'result']) $(s).classList.toggle('hidden', s !== name); scrollTo(0, 0); };
  const fail = m => { $('loading').classList.add('hidden'); $('msg').textContent = m; $('msg').classList.remove('hidden'); };

  (async () => {
    if (!configured) return fail('Supabase is not configured. Copy .env.example to .env and add your keys.');
    const id = new URLSearchParams(location.search).get('id');
    if (!id) return fail('No test selected. Please pick a test from your dashboard.');
    const user = await requireUser();
    if (!user) return;

    const [{ data: test }, profile] = await Promise.all([
      supabase.from('tests').select('*').eq('id', id).maybeSingle(),
      getProfile(user.id),
    ]);
    if (!test) return fail('Test not found.');

    // Row Level Security decides this: paid test + no active pass = no rows returned.
    const { data: qrow } = await supabase.from('test_questions').select('questions').eq('test_id', id).maybeSingle();
    if (!qrow || !Array.isArray(qrow.questions) || !qrow.questions.length) {
      if (!test.is_free && !isPro(profile)) {
        $('locked-title').textContent = test.title;
        $('locked-pay').textContent = `Pay ₹${PLAN_PRICE} to Unlock`;
        return only('locked');
      }
      return fail('Questions for this test have not been added yet.');
    }

    const Q = qrow.questions, N = Q.length, KEY = `mock:${user.id}:${id}`;
    const total = N, mins = test.duration_minutes;
    let S = null, timer = 0, saved = false;
    const load = () => { try { return JSON.parse(localStorage.getItem(KEY)); } catch (e) { return null; } };
    const persist = () => { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) {} };
    const clear = () => { try { localStorage.removeItem(KEY); } catch (e) {} };
    const fresh = () => ({ end: Date.now() + mins * 60000, start: Date.now(), ans: Array(N).fill(-1), mark: Array(N).fill(0), i: 0 });

    $('i-cat').textContent = test.category;
    $('i-title').textContent = test.title;
    $('e-title').textContent = test.title;
    $('r-title').textContent = test.title;
    $('i-q').textContent = `${N} questions`;
    $('i-d').textContent = `${mins} minutes`;

    function draw() {
      const q = Q[S.i], a = S.ans[S.i];
      $('qn').textContent = `Question ${S.i + 1} of ${N}`;
      $('qt').textContent = q.question;
      $('opts').innerHTML = q.options.map((o, k) => `<button type="button" role="radio" aria-checked="${a === k}" data-k="${k}" class="flex w-full items-start gap-3 rounded-xl border-2 px-4 py-3 text-left transition ${a === k ? 'border-indigo-500 bg-indigo-50' : 'border-slate-200 hover:border-indigo-300'}"><span class="grid h-6 w-6 flex-none place-items-center rounded-full text-xs font-bold ${a === k ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600'}">${L[k]}</span><span>${esc(o)}</span></button>`).join('');
      $('mark').textContent = S.mark[S.i] ? 'Unmark review' : 'Mark for Review';
      $('prev').disabled = S.i === 0;
      $('next').textContent = S.i === N - 1 ? 'Save' : 'Save & Next';
      $('pal').innerHTML = Q.map((_, k) => {
        const cls = S.mark[k] ? 'bg-violet-500 text-white' : S.ans[k] >= 0 ? 'bg-emerald-500 text-white' : 'bg-slate-200 text-slate-700';
        return `<button type="button" data-i="${k}" class="aspect-square rounded-lg text-sm font-semibold ${cls} ${k === S.i ? 'ring-2 ring-slate-900 ring-offset-1' : ''}" aria-label="Question ${k + 1}">${k + 1}</button>`;
      }).join('');
    }
    function tick() {
      const r = Math.round((S.end - Date.now()) / 1000);
      $('timer').textContent = fmtTime(r);
      $('timer').className = 'rounded-full px-3 py-1 font-semibold tabular-nums ' + (r <= 60 ? 'bg-rose-100 text-rose-700' : 'bg-slate-100 text-slate-800');
      if (r <= 0) finish();
    }
    function run() { only('exam'); draw(); clearInterval(timer); timer = setInterval(tick, 1000); tick(); }
    const go = i => { S.i = Math.min(N - 1, Math.max(0, i)); persist(); draw(); };

    async function finish() {
      clearInterval(timer);
      let c = 0, w = 0;
      Q.forEach((q, k) => { if (S.ans[k] >= 0) { if (S.ans[k] === q.correctIndex) c++; else w++; } });
      const att = c + w, used = Math.min(mins * 60, Math.round((Date.now() - S.start) / 1000));
      const acc = att ? Math.round(c / att * 100) : 0;
      const answers = S.ans.slice();
      clear();

      $('stats').innerHTML = [['Score', `${c} / ${total}`], ['Accuracy', acc + '%'], ['Time taken', fmtTime(used)], ['Correct', c], ['Wrong', w], ['Skipped', N - att]]
        .map(([k, v]) => `<div class="rounded-2xl border border-slate-200 bg-white p-4"><p class="text-2xl font-bold text-slate-900">${v}</p><p class="text-xs text-slate-500">${k}</p></div>`).join('');
      $('review').innerHTML = Q.map((q, k) => {
        const a = answers[k], ok = a === q.correctIndex;
        const tag = a < 0 ? ['Skipped', 'bg-slate-100 text-slate-600'] : ok ? ['Correct', 'bg-emerald-100 text-emerald-700'] : ['Wrong', 'bg-rose-100 text-rose-700'];
        return `<article class="rounded-2xl border border-slate-200 bg-white p-5"><div class="flex items-start justify-between gap-3"><h3 class="font-semibold text-slate-900">${k + 1}. ${esc(q.question)}</h3><span class="flex-none rounded-full px-2.5 py-0.5 text-xs font-semibold ${tag[1]}">${tag[0]}</span></div>
          <ul class="mt-3 space-y-1.5 text-sm">${q.options.map((o, j) => `<li class="rounded-lg px-3 py-2 ${j === q.correctIndex ? 'bg-emerald-50 font-medium text-emerald-800' : j === a ? 'bg-rose-50 text-rose-700' : 'text-slate-600'}">${L[j]}. ${esc(o)}${j === q.correctIndex ? ' ✓ Correct answer' : j === a ? ' (your answer)' : ''}</li>`).join('')}</ul>
          ${q.explanation ? `<p class="mt-3 rounded-lg bg-slate-50 px-3 py-2 text-sm text-slate-600"><span class="font-semibold text-slate-700">Explanation:</span> ${esc(q.explanation)}</p>` : ''}</article>`;
      }).join('');
      only('result');

      if (!saved) {
        saved = true;
        $('saved').textContent = 'Saving your attempt...';
        const { error } = await supabase.from('test_attempts').insert({ test_id: id, score: c, total, time_taken_seconds: used });
        $('saved').textContent = error ? 'Could not save this attempt: ' + error.message : 'Attempt saved to your history.';
      }
    }

    // events
    $('opts').addEventListener('click', e => { const b = e.target.closest('[data-k]'); if (b) { S.ans[S.i] = +b.dataset.k; persist(); draw(); } });
    $('pal').addEventListener('click', e => { const b = e.target.closest('[data-i]'); if (b) go(+b.dataset.i); });
    $('prev').addEventListener('click', () => go(S.i - 1));
    $('next').addEventListener('click', () => go(S.i + 1));
    $('mark').addEventListener('click', () => { S.mark[S.i] = S.mark[S.i] ? 0 : 1; persist(); draw(); });
    $('submit').addEventListener('click', () => {
      const left = S.ans.filter(x => x < 0).length;
      if (confirm(left ? `${left} question(s) not answered. Submit the test?` : 'Submit the test?')) finish();
    });
    $('retake').addEventListener('click', () => { saved = false; S = fresh(); persist(); run(); });
    $('start').addEventListener('click', () => { if (!S || S.end <= Date.now()) { S = fresh(); persist(); } run(); });

    // resume a test left running (refresh, power cut)
    S = load();
    const live = S && S.end > Date.now() && Array.isArray(S.ans) && S.ans.length === N;
    if (!live) S = null;
    $('start').textContent = live ? 'Resume test' : 'Start Test';
    only('intro');
  })();
</script>
