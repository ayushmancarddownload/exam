---
import Base from '../layouts/Base.astro';
---
<Base title="Dashboard">
  <main class="mx-auto max-w-6xl px-4 py-8">
    <div id="msg" class="hidden rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>
    <div id="loading" class="py-20 text-center text-slate-500">Loading your dashboard...</div>

    <div id="app" class="hidden">
      <p class="text-sm text-slate-500">Signed in as <span id="user-email" class="font-medium text-slate-800"></span></p>
      <div id="plan" class="mt-3"></div>

      <h2 class="mt-8 text-xl font-bold text-slate-900">Mock tests</h2>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <input id="search" type="search" placeholder="Search tests" aria-label="Search tests" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm sm:w-64" />
        <div id="types" class="flex gap-1.5"></div>
      </div>
      <div id="cats" class="mt-3 flex flex-wrap gap-2"></div>
      <div id="grid" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

      <h2 class="mt-10 text-xl font-bold text-slate-900">Recent attempts</h2>
      <div id="history" class="mt-3"></div>
    </div>
  </main>
</Base>

<script>
  import { supabase, configured } from '../lib/supabase.js';
  import { requireUser, getProfile, isPro, daysLeft } from '../lib/auth.js';
  import { esc, fmtDate } from '../lib/ui.js';
  import { PLAN_PRICE } from '../lib/config.js';
  import { u } from '../lib/url.js';

  const $ = id => document.getElementById(id);
  const fail = m => { $('loading').classList.add('hidden'); $('msg').textContent = m; $('msg').classList.remove('hidden'); };

  (async () => {
    if (!configured) return fail('Supabase is not configured. Copy .env.example to .env and add your keys.');
    const user = await requireUser();
    if (!user) return;

    const [profile, tRes, aRes] = await Promise.all([
      getProfile(user.id),
      supabase.from('tests').select('*').order('sort_order'),
      supabase.from('test_attempts').select('id,test_id,score,total,submitted_at,tests(title)').order('submitted_at', { ascending: false }).limit(200),
    ]);
    if (tRes.error) return fail('Could not load tests: ' + tRes.error.message);

    const tests = tRes.data || [], attempts = aRes.data || [];
    const pro = isPro(profile);
    const last = {};
    attempts.forEach(a => { if (!last[a.test_id]) last[a.test_id] = a; });

    $('user-email').textContent = user.email;

    // plan banner
    if (pro) {
      const d = daysLeft(profile);
      $('plan').innerHTML = `<div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4">
        <div><span class="rounded-full bg-emerald-600 px-3 py-1 text-xs font-bold text-white">Pro Active (${d} day${d === 1 ? '' : 's'} left)</span>
        <p class="mt-2 text-sm text-emerald-900">Pro Plan Active - Expires on ${fmtDate(profile.plan_expiry)}</p></div></div>`;
    } else {
      const expired = profile && profile.plan_expiry;
      $('plan').innerHTML = `<div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-indigo-200 bg-indigo-50 px-5 py-4">
        <div><p class="font-semibold text-indigo-900">${expired ? 'Your Pro plan expired on ' + fmtDate(profile.plan_expiry) : 'Free Plan'}</p>
        <p class="text-sm text-indigo-800">Unlock all tests for ₹${PLAN_PRICE} / 30 days.</p></div>
        <button type="button" data-open-pay class="rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700">Upgrade to Pro (₹${PLAN_PRICE} / 30 Days)</button></div>`;
    }

    // filters
    const cats = ['All', ...new Set(tests.map(t => t.category))];
    const state = { cat: 'All', type: 'all', q: '' };
    const chip = (on) => on ? 'bg-indigo-600 text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-100';

    function renderFilters() {
      $('cats').innerHTML = cats.map(c => `<button type="button" data-cat="${esc(c)}" class="rounded-full px-3.5 py-1.5 text-sm font-medium ${chip(state.cat === c)}">${esc(c)}</button>`).join('');
      $('types').innerHTML = [['all', 'All'], ['free', 'Free'], ['pro', 'Pro']].map(([k, l]) => `<button type="button" data-type="${k}" class="rounded-full px-3.5 py-1.5 text-sm font-medium ${chip(state.type === k)}">${l}</button>`).join('');
    }
    function renderGrid() {
      const list = tests.filter(t => (state.cat === 'All' || t.category === state.cat)
        && (state.type === 'all' || (state.type === 'free') === t.is_free)
        && t.title.toLowerCase().includes(state.q));
      if (!list.length) { $('grid').innerHTML = '<p class="col-span-full rounded-xl bg-white p-6 text-center text-slate-500">No tests match your filters.</p>'; return; }
      $('grid').innerHTML = list.map(t => {
        const unlocked = t.is_free || pro;
        const a = last[t.id];
        const btn = unlocked
          ? `<a href="${u('/test/')}?id=${t.id}" class="block rounded-xl bg-indigo-600 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-indigo-700">${a ? 'Attempt again' : 'Start Test'}</a>`
          : `<button type="button" data-open-pay class="block w-full rounded-xl bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-slate-700">🔒 Unlock for ₹${PLAN_PRICE}</button>`;
        return `<div class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5">
          <div class="flex items-start justify-between gap-2"><h3 class="font-semibold text-slate-900">${esc(t.title)}</h3>
          <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold ${t.is_free ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}">${t.is_free ? 'Free' : 'Pro'}</span></div>
          <p class="mt-1 text-sm text-slate-500">${esc(t.category)} · ${t.total_questions} questions · ${t.duration_minutes} min</p>
          ${a ? `<p class="mt-2 text-xs text-slate-500">Last score: <span class="font-semibold text-slate-700">${a.score}/${a.total}</span></p>` : ''}
          <div class="mt-4 flex-1 flex items-end"><div class="w-full">${btn}</div></div></div>`;
      }).join('');
    }
    renderFilters(); renderGrid();

    $('cats').addEventListener('click', e => { const b = e.target.closest('[data-cat]'); if (b) { state.cat = b.dataset.cat; renderFilters(); renderGrid(); } });
    $('types').addEventListener('click', e => { const b = e.target.closest('[data-type]'); if (b) { state.type = b.dataset.type; renderFilters(); renderGrid(); } });
    $('search').addEventListener('input', e => { state.q = e.target.value.trim().toLowerCase(); renderGrid(); });

    // history
    const recent = attempts.slice(0, 8);
    $('history').innerHTML = recent.length
      ? `<div class="divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-200 bg-white">${recent.map(a => {
          const pct = a.total ? Math.round(a.score / a.total * 100) : 0;
          return `<div class="flex items-center justify-between gap-3 px-5 py-3.5"><div class="min-w-0"><p class="truncate font-medium text-slate-900">${esc(a.tests ? a.tests.title : 'Test')}</p><p class="text-xs text-slate-500">${fmtDate(a.submitted_at)}</p></div>
          <div class="text-right"><p class="font-semibold text-slate-900">${a.score}/${a.total}</p><p class="text-xs ${pct >= 60 ? 'text-emerald-600' : 'text-amber-600'}">${pct}%</p></div></div>`;
        }).join('')}</div>`
      : '<p class="rounded-xl bg-white p-6 text-center text-slate-500 ring-1 ring-slate-200">No attempts yet. Start a free test above.</p>';

    $('loading').classList.add('hidden');
    $('app').classList.remove('hidden');
  })();
</script>
