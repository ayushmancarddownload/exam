---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import PaymentModal from '../components/PaymentModal.astro';
import { SITE_NAME } from '../lib/config.js';
import { u } from '../lib/url.js';
const { title, description = 'Free online mock tests with instant results. All tests for just ₹29 a month.' } = Astro.props;
const full = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#4f46e5" />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
</head>
<body class="min-h-screen bg-slate-50 text-slate-800 antialiased flex flex-col">
  <Navbar />
  <div class="flex-1"><slot /></div>
  <footer class="mt-12 border-t border-slate-200 bg-white py-6 text-center text-sm text-slate-500">
    <p>&copy; {new Date().getFullYear()} {SITE_NAME}. Practice tests for exam preparation.</p>
  </footer>
  <PaymentModal />
</body>
</html>
