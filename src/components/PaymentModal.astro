---
---
<div id="pay-modal" class="fixed inset-0 z-50 hidden items-end justify-center bg-slate-900/60 p-0 sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-labelledby="pay-title">
  <div class="max-h-[92vh] w-full max-w-md overflow-y-auto rounded-t-3xl bg-white p-6 shadow-2xl sm:rounded-3xl">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="pay-title" class="text-xl font-bold text-slate-900">Upgrade to Pro</h2>
        <p class="text-sm text-slate-500">Instant activation after payment — all tests unlocked</p>
      </div>
      <button id="pay-close" type="button" class="rounded-full p-2 text-slate-500 hover:bg-slate-100" aria-label="Close">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>

    <p id="pay-email" class="mt-4 rounded-lg bg-indigo-50 px-3 py-2 text-xs font-medium text-indigo-800"></p>
    <p id="pay-error" class="mt-3 hidden rounded-lg bg-red-50 px-3 py-2 text-xs font-medium text-red-700"></p>

    <div id="pay-plans" class="mt-4 space-y-3">
      <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50 p-4">
        <div>
          <p class="text-base font-bold text-slate-900">30 Days Pro</p>
          <p class="text-xs text-slate-500">All mock tests unlocked for 30 days</p>
        </div>
        <button type="button" data-plan="pro_30" data-label="Pay ₹29" class="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow hover:bg-slate-800 disabled:opacity-50">
          Pay ₹29
        </button>
      </div>

      <div class="relative flex items-center justify-between rounded-2xl border-2 border-indigo-600 bg-indigo-50/40 p-4">
        <span class="absolute -top-2.5 left-4 rounded-full bg-indigo-600 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Best Value</span>
        <div>
          <p class="text-base font-bold text-slate-900">120 Days Pro</p>
          <p class="text-xs text-slate-500">All mock tests unlocked for 120 days</p>
        </div>
        <button type="button" data-plan="pro_120" data-label="Pay ₹99" class="rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow hover:bg-indigo-700 disabled:opacity-50">
          Pay ₹99
        </button>
      </div>
    </div>

    <a id="pay-login-btn" href="#" class="mt-4 hidden w-full items-center justify-center rounded-xl bg-indigo-600 px-4 py-3 text-base font-semibold text-white shadow hover:bg-indigo-700">
      Login to Upgrade
    </a>

    <p class="mt-4 text-center text-xs text-slate-400">
      Secure UPI, GPay, PhonePe, Paytm & Card payment via Instamojo
    </p>
  </div>
</div>

<script>
  import { getUser } from '../lib/auth.js';
  import { supabase } from '../lib/supabase.js';
  import { toast } from '../lib/ui.js';
  import { u } from '../lib/url.js';

  const modal = document.getElementById('pay-modal');
  const plansBox = document.getElementById('pay-plans');
  const loginBtn = document.getElementById('pay-login-btn');
  const note = document.getElementById('pay-email');
  const errorBox = document.getElementById('pay-error');

  // Show message if redirected back from Instamojo
  const urlParams = new URLSearchParams(location.search);
  const payStatus = urlParams.get('payment_status');
  if (payStatus === 'Credit') {
    toast('Payment successful! Your Pro plan is active.');
    ['payment_id', 'payment_status', 'payment_request_id', 'payment'].forEach(k => urlParams.delete(k));
    const cleanUrl = location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
    history.replaceState(null, '', cleanUrl);
  } else if (payStatus === 'Failed') {
    toast('Payment failed or cancelled.');
  }

  const open = async () => {
    errorBox.classList.add('hidden');
    const user = await getUser();
    if (user) {
      plansBox.classList.remove('hidden');
      loginBtn.classList.add('hidden');
      loginBtn.classList.remove('flex');
      note.textContent = `Account: ${user.email} — Payment ke turant baad Pro activate ho jayega.`;
    } else {
      plansBox.classList.add('hidden');
      loginBtn.href = u('/login/') + '?next=' + encodeURIComponent(location.pathname + location.search);
      loginBtn.classList.remove('hidden');
      loginBtn.classList.add('flex');
      note.textContent = 'Upgrade karne ke liye pehle Login karein.';
    }
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  };

  const close = () => {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  };

  document.addEventListener('click', e => {
    if (e.target.closest('[data-open-pay]')) {
      e.preventDefault();
      open();
    }
  });
  document.getElementById('pay-close').addEventListener('click', close);
  modal.addEventListener('click', e => { if (e.target === modal) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

  document.querySelectorAll('[data-plan]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const planId = btn.getAttribute('data-plan');
      errorBox.classList.add('hidden');

      if (!supabase) {
        errorBox.textContent = 'Supabase configured nahi hai.';
        errorBox.classList.remove('hidden');
        return;
      }

      const { data: sessionData } = await supabase.auth.getSession();
      const token = sessionData?.session?.access_token;
      if (!token) {
        location.href = u('/login/') + '?next=' + encodeURIComponent(location.pathname + location.search);
        return;
      }

      const allBtns = document.querySelectorAll('[data-plan]');
      allBtns.forEach(b => { b.disabled = true; });
      btn.textContent = 'Opening...';

      try {
        const { data, error } = await supabase.functions.invoke('create-instamojo-payment', {
          body: { planId },
          headers: { Authorization: `Bearer ${token}` },
        });

        if (error || !data?.paymentUrl) {
          throw new Error(data?.error || error?.message || 'Payment link nahi ban paya.');
        }

        window.location.href = data.paymentUrl;
      } catch (err) {
        errorBox.textContent = err.message || 'Payment start karne mein error aaya.';
        errorBox.classList.remove('hidden');
        allBtns.forEach(b => {
          b.disabled = false;
          b.textContent = b.getAttribute('data-label');
        });
        toast('Payment start nahi ho paya');
      }
    });
  });
</script>
