---
import { ADMIN_UPI_ID, PLAN_PRICE, PLAN_DAYS } from '../lib/config.js';
import { u } from '../lib/url.js';
const upiLink = `upi://pay?pa=${encodeURIComponent(ADMIN_UPI_ID)}&am=${PLAN_PRICE}&cu=INR&tn=${encodeURIComponent('Mock Test Pass')}`;
---
<div id="pay-modal" class="fixed inset-0 z-50 hidden items-end justify-center bg-slate-900/60 p-0 sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-labelledby="pay-title">
  <div class="max-h-[92vh] w-full max-w-md overflow-y-auto rounded-t-3xl bg-white p-6 shadow-2xl sm:rounded-3xl">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="pay-title" class="text-xl font-bold text-slate-900">Upgrade to Pro</h2>
        <p class="text-sm text-slate-500">₹{PLAN_PRICE} for {PLAN_DAYS} days, all tests unlocked</p>
      </div>
      <button id="pay-close" type="button" class="rounded-full p-2 text-slate-500 hover:bg-slate-100" aria-label="Close">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>

    <div class="mt-5 flex flex-col items-center rounded-2xl border border-slate-200 bg-slate-50 p-4">
      <img src={u('/upi-qr.png')} alt="UPI QR code" width="200" height="200" class="h-48 w-48 rounded-lg bg-white object-contain" />
      <p class="mt-3 text-xs uppercase tracking-wide text-slate-500">UPI ID</p>
      <div class="mt-1 flex items-center gap-2">
        <code id="upi-id" class="rounded-lg bg-white px-3 py-1.5 text-sm font-semibold text-slate-900 ring-1 ring-slate-200">{ADMIN_UPI_ID}</code>
        <button id="copy-upi" type="button" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700">Copy UPI ID</button>
      </div>
      <a href={upiLink} class="mt-3 text-sm font-medium text-indigo-600 underline sm:hidden">Open in UPI app</a>
    </div>

    <ol class="mt-5 space-y-2 text-sm text-slate-600">
      <li class="flex gap-3"><span class="grid h-6 w-6 flex-none place-items-center rounded-full bg-indigo-100 text-xs font-bold text-indigo-700">1</span>Pay ₹{PLAN_PRICE} using PhonePe, GPay or Paytm.</li>
      <li class="flex gap-3"><span class="grid h-6 w-6 flex-none place-items-center rounded-full bg-indigo-100 text-xs font-bold text-indigo-700">2</span>Click the WhatsApp button below and send the payment screenshot.</li>
      <li class="flex gap-3"><span class="grid h-6 w-6 flex-none place-items-center rounded-full bg-indigo-100 text-xs font-bold text-indigo-700">3</span>Your account is activated within 10 to 15 minutes.</li>
    </ol>

    <p id="pay-email" class="mt-4 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800"></p>

    <a id="wa-btn" href="#" target="_blank" rel="noopener" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-green-600 px-4 py-3 text-base font-semibold text-white shadow hover:bg-green-700">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.1.1.7-.1 1.3z"/></svg>
      Send Screenshot on WhatsApp
    </a>
  </div>
</div>

<script>
  import { getUser } from '../lib/auth.js';
  import { toast } from '../lib/ui.js';
  import { ADMIN_UPI_ID, WHATSAPP_NUMBER, PLAN_PRICE, PLAN_DAYS } from '../lib/config.js';
  import { u } from '../lib/url.js';

  const modal = document.getElementById('pay-modal');
  const open = async () => {
    const user = await getUser();
    const wa = document.getElementById('wa-btn');
    const note = document.getElementById('pay-email');
    if (user) {
      const msg = `Hello Sir, I have paid ₹${PLAN_PRICE} for the ${PLAN_DAYS}-day Mock Test Pass. My registered email is: ${user.email}. Here is my payment screenshot.`;
      wa.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`;
      wa.removeAttribute('aria-disabled');
      wa.classList.remove('opacity-50');
      note.textContent = `Your registered email: ${user.email}. It is added to the WhatsApp message automatically.`;
    } else {
      wa.href = u('/login/') + '?next=' + encodeURIComponent(location.pathname + location.search);
      wa.removeAttribute('target');
      note.textContent = 'Please log in first so we can activate the right account.';
    }
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  };
  const close = () => {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  };

  // Any element with data-open-pay opens the modal (works for buttons added later by JS too).
  document.addEventListener('click', e => { if (e.target.closest('[data-open-pay]')) { e.preventDefault(); open(); } });
  document.getElementById('pay-close').addEventListener('click', close);
  modal.addEventListener('click', e => { if (e.target === modal) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

  document.getElementById('copy-upi').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(ADMIN_UPI_ID); }
    catch (err) {
      const t = document.createElement('textarea'); t.value = ADMIN_UPI_ID; document.body.appendChild(t); t.select();
      try { document.execCommand('copy'); } catch (e2) {} t.remove();
    }
    toast('UPI ID copied');
  });
</script>
