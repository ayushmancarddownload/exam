---
import { SITE_NAME } from '../lib/config.js';
import { u } from '../lib/url.js';
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">
    <a href={u('/')} class="flex items-center gap-2 text-lg font-extrabold text-slate-900">
      <span class="grid h-7 w-7 place-items-center rounded-lg bg-indigo-600 text-white" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg>
      </span>
      {SITE_NAME}
    </a>
    <nav id="nav-links" class="flex items-center gap-1 text-sm font-medium" aria-label="Main">
      <a href={u('/login/')} class="rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100">Login</a>
      <a href={u('/login/?tab=signup')} class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Start free</a>
    </nav>
  </div>
</header>
<script>
  import { getUser, logout } from '../lib/auth.js';
  import { u } from '../lib/url.js';
  (async () => {
    const user = await getUser();
    if (!user) return;
    const nav = document.getElementById('nav-links');
    nav.innerHTML = `
      <a href="${u('/dashboard/')}" class="rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100">Dashboard</a>
      <button id="logout" type="button" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-700 hover:bg-slate-100">Logout</button>`;
    document.getElementById('logout').addEventListener('click', logout);
  })();
</script>
